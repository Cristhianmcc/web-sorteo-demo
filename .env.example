# ============================================================
# IDs DE MARKETING Y ANALÍTICA
# Copia este archivo como ".env.local" y pega tus IDs reales.
# Mientras estén vacíos, la web funciona igual pero NO envía
# datos a ninguna plataforma (modo aprendizaje seguro).
# ============================================================

# Google Analytics 4 — se ve así: G-XXXXXXXXXX
# Dónde conseguirlo: analytics.google.com → Crear propiedad → Flujo web
NEXT_PUBLIC_GA_ID=

# Meta Pixel — se ve así: 123456789012345
# Dónde conseguirlo: business.facebook.com → Administrador de eventos → Píxeles
NEXT_PUBLIC_META_PIXEL_ID=

# TikTok Pixel — se ve así: ABC123DEF456
# Dónde conseguirlo: ads.tiktok.com → Herramientas → Eventos
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Microsoft Clarity — se ve así: abcdef1234
# Dónde conseguirlo: clarity.microsoft.com → Nuevo proyecto
NEXT_PUBLIC_CLARITY_ID=
